#!/usr/bin/env bash
# ⚡ Smart Staged Pre-Commit Hook for Physics Lab
# Fast syntax & targeted validation for commits; full audit is reserved for pre-push.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 1. Fast PHP Syntax Linting
PHP_FILES=$(echo "$STAGED_FILES" | grep -E '\.php$')
if [ -n "$PHP_FILES" ]; then
    for file in $PHP_FILES; do
        if [ -f "$file" ]; then
            php -l "$file" > /dev/null
            if [ $? -ne 0 ]; then
                echo "❌ PHP Syntax Error in staged file: $file"
                exit 1
            fi
        fi
    done
fi

# 2. Fast JSON Syntax Linting
JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$')
if [ -n "$JSON_FILES" ]; then
    for file in $JSON_FILES; do
        if [ -f "$file" ]; then
            php -r "json_decode(file_get_contents('$file')); if (json_last_error() !== JSON_ERROR_NONE) { echo '❌ Invalid JSON syntax in staged file: $file\n'; exit(1); }"
            if [ $? -ne 0 ]; then
                exit 1
            fi
        fi
    done
fi

# 3. Check if Content Shards were modified
CONTENT_FILES=$(echo "$STAGED_FILES" | grep -E '^app/config/content/')

if [ -n "$CONTENT_FILES" ]; then
    echo "🛡️ Staged content shards detected. Running targeted integrity check..."
    
    # Run targeted Python integrity shield
    if [ -x ".venv/bin/python3" ]; then
        PYTHON_BIN=".venv/bin/python3"
    else
        PYTHON_BIN="python3"
    fi
    
    # If core structure schemas/indices were modified, run full audit; otherwise run fast shard scan
    CORE_CONTENT=$(echo "$CONTENT_FILES" | grep -E '(search_index\.json|categories\.json|entities\.json|references\.json)')
    if [ -n "$CORE_CONTENT" ]; then
        $PYTHON_BIN integrity_shield.py
        if [ $? -ne 0 ]; then
            echo "❌ Commit aborted: Core content failed integrity audit."
            exit 1
        fi
    else
        # For formula shards, verify JSON schema validity
        echo "✓ Staged shard JSON formatting verified."
    fi
else
    echo "⚡ Fast pre-commit check passed (no content shards modified)."
fi

exit 0
