{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Physics Formula Shard Schema",
    "description": "Schema for sharded formula files in the Physics Lab project.",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "required": [
            "title",
            "equation",
            "status",
            "category",
            "description",
            "conceptual_definition",
            "intuitive_summary",
            "interpretation",
            "symmetry_origin",
            "limits_and_boundary",
            "semantic_variables"
        ],
        "properties": {
            "title": {
                "type": "string",
                "minLength": 3,
                "not": {
                    "pattern": "^([Cc]ustom [Pp]hysical [Rr]elation|[Tt]echnical [Rr]elation\\b|[Uu]nknown [Ff]ormula$)"
                },
                "description": "The display title of the formula."
            },
            "equation": {
                "type": "string",
                "minLength": 1,
                "description": "The LaTeX or compiled SVG string containing the formula."
            },
            "category": {
                "type": "string",
                "enum": [
                    "astrophysics",
                    "classical-mechanics",
                    "condensed-matter",
                    "electromagnetism",
                    "fluids-nonlinear",
                    "mathematical-methods",
                    "philosophy-of-physics",
                    "quantum-physics",
                    "relativity",
                    "standard-model",
                    "theoretical-physics",
                    "thermodynamics-statistical-mechanics"
                ],
                "description": "Canonical primary physics domain category."
            },
            "description": {
                "type": "string",
                "minLength": 20,
                "description": "Concise one-sentence summary of what the formula specifies or governs."
            },
            "conceptual_definition": {
                "type": "string",
                "minLength": 20,
                "description": "High-level conceptual explanation of the physical law or identity."
            },
            "intuitive_summary": {
                "type": "string",
                "minLength": 20,
                "description": "Plain-English intuitive summary of the equation's physical meaning."
            },
            "semantic_variables": {
                "type": "object",
                "minProperties": 1,
                "description": "Explicit mappings of LaTeX symbols to constants or concepts.",
                "additionalProperties": {
                    "anyOf": [
                        {
                            "type": "object",
                            "properties": {
                                "ref": { "type": "string" },
                                "type": { "type": "string" },
                                "name": { "type": "string" }
                            }
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "interpretation": { "type": "string", "minLength": 20 },
            "symmetry_origin": { "type": "string", "minLength": 20 },
            "limits_and_boundary": { "type": "string", "minLength": 20 },
            "status": {
                "type": "string",
                "enum": ["platinum", "platinum-draft", "draft", "published"]
            },
            "unit_system": {
                "type": "string",
                "enum": ["SI", "natural", "gaussian", "cgs", "heaviside-lorentz"],
                "default": "SI",
                "description": "The dimensional unit system profile used to evaluate this formula (simplifies base dimensions dynamically)."
            },
            "parent_formula_id": {
                "type": ["string", "null"],
                "description": "The formula ID of the parent master equation if this formula is a subcomponent."
            },
            "subcomponents": {
                "type": "array",
                "items": { "type": "string" },
                "description": "A list of formula IDs for subcomponent equations contained within this master equation."
            },
            "equation_family": {
                "type": ["string", "null"],
                "description": "Slug representing the equation family cluster."
            },
            "derivation_type": {
                "type": ["string", "null"],
                "enum": [
                    "AXIOMATIC_FOUNDATION",
                    "DEFINITION",
                    "DERIVED_FROM",
                    "SPECIAL_CASE",
                    "GENERALIZATION",
                    "LIMITING_CASE",
                    "APPROXIMATION",
                    "EMPIRICAL_LAW",
                    "THEORETICAL_DERIVATION",
                    "PHENOMENOLOGICAL",
                    null
                ],
                "description": "Classification of the mathematical derivation relationship."
            },
            "lineage_confidence": {
                "type": "string",
                "enum": ["curated", "cas_verified", "root_axiom", "heuristic"],
                "description": "Provenance confidence tier for the derivation lineage link."
            },
            "derivation_steps": {
                "type": "array",
                "description": "Sequential intermediate mathematical derivation steps connecting from parent axiom to child formula.",
                "items": {
                    "type": "object",
                    "required": ["step", "latex", "rationale"],
                    "properties": {
                        "step": { "type": "integer" },
                        "latex": { "type": "string" },
                        "rationale": { "type": "string" }
                    }
                }
            },
            "cas_validation": {
                "type": "object",
                "description": "Symbolic CAS validation metadata certifying dimensional homogeneity and algebraic consistency.",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": ["HOMOGENEOUS", "DIMENSIONAL_EXPRESSION", "INHOMOGENEOUS", "OPERATOR_OR_TENSOR", "PARSE_ERROR", "UNVERIFIED"]
                    },
                    "is_homogeneous": { "type": ["boolean", "null"] },
                    "quantity": { "type": ["string", "null"] },
                    "dimension_latex": { "type": ["string", "null"] },
                    "verified_at": { "type": ["integer", "null"] }
                }
            }
        }
    }
}
