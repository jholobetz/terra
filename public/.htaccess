Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to hidden dotfiles while exempting /.well-known/ for Let's Encrypt HTTP-01 renewals
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule (?:^|/)\. - [F,L]

    # Route all non-file, non-directory requests through FlightPHP front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Gzip compression (~75% payload reduction on MathJax tex-svg-full.js, math.min.js, CSS, HTML, and JSON)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html \
        text/plain \
        text/css \
        text/xml \
        application/xml \
        application/xhtml+xml \
        application/rss+xml \
        application/javascript \
        text/javascript \
        application/x-javascript \
        application/json \
        image/svg+xml
</IfModule>

# Long-lived browser caching for ?v=filemtime cache-busted static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|svg|woff2|woff|ttf|png|jpe?g|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:js|css|xml|gz|html|svg|json)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>
